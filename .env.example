# Copy this file to .env and fill in your values. Never commit .env.

# ── Supabase (React app) ─────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Service-role key — server/script use only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Sheets sync script (Node.js only) ─────────────────────────────────
GOOGLE_SHEET_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Google Calendar IDs (React app) ──────────────────────────────────────────
VITE_CALENDAR_PROGRAMS=
VITE_CALENDAR_SCHOOL=
VITE_CALENDAR_CIRCLES=

# ── SMS verification feature flag (React app) ────────────────────────────────
# Controls the Twilio SMS login seam. Leave OFF until A2P/10DLC compliance is
# approved. Only the exact string "true" enables it; unset/anything else = OFF.
#   OFF (default): pure phone-number lookup, no code screen (today's behavior).
#   ON:            phone lookup -> SMS code -> verify -> login.
# See TWILIO_INTEGRATION.md for the full enable checklist.
VITE_SMS_VERIFICATION_ENABLED=false

# ── Twilio (NOT YET ACTIVE — leave blank until SMS is enabled) ────────────────
# These power api/send-code.js and api/verify-code.js, which are currently STUBS.
# Do not fill these in until VITE_SMS_VERIFICATION_ENABLED is being flipped on.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# TWILIO_PHONE_NUMBER=
