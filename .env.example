# Copy this file to .env and fill in your values. Never commit .env.

# ── Supabase (React app) ─────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Service-role key — server/script use only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Sheets sync script (Node.js only) ─────────────────────────────────
GOOGLE_SHEET_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Google Calendar IDs (React app) ──────────────────────────────────────────
VITE_CALENDAR_PROGRAMS=
VITE_CALENDAR_SCHOOL=
VITE_CALENDAR_CIRCLES=

# ── SMS verification feature flag (React app) ────────────────────────────────
# Controls the Twilio SMS login flow. Only the exact string "true" enables it;
# unset/anything else = OFF.
#   OFF: pure phone-number lookup, no code screen.
#   ON:  phone lookup -> SMS code -> verify -> login.
# Must be set BOTH here (local) and in the Netlify build environment for prod.
# See TWILIO_INTEGRATION.md for the full enable checklist.
VITE_SMS_VERIFICATION_ENABLED=true

# ── Twilio (server side — set these in Netlify env vars too) ──────────────────
# These power netlify/functions/send-code.js and verify-code.js, which send a
# 6-digit code via the Twilio Messages API and store it in the Supabase
# `verification_codes` table (create it with supabase/verification_codes.sql).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
